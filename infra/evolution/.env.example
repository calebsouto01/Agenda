# Copie para .env e preencha. NUNCA envie o .env para o GitHub.
# Subdomínio que aponta para o IP do servidor, ex.: evolution.seudominio.com.br
EVOLUTION_DOMAIN=evolution.seudominio.com.br
# Chave de administração da Evolution (gere com: openssl rand -hex 32)
EVOLUTION_API_KEY=
# Senha do banco (gere com: openssl rand -hex 16)
POSTGRES_PASSWORD=
